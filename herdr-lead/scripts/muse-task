#!/bin/bash
# Start and follow a herdr-lead task through hc. Callers outside Herdr
# (Muse over Rex) have a minimal PATH, and hc starts programs with the
# core's environment rather than the caller's, so the usual install
# locations are added here and passed to the lead explicitly.
set -euo pipefail

export PATH="$PATH:$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin"

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${MUSE_TASK_STATE:-$HOME/.local/state/muse-task}"
CODER_MODEL="${MUSE_TASK_CODER_MODEL:-gpt-6.1-sol}"
CODER_EFFORT="${MUSE_TASK_CODER_EFFORT:-low}"

usage() {
    cat <<'USAGE'
Usage:
  muse-task start <repo> <task>       Start a lead in the repository
  muse-task run <repo> <task> [secs]  Start a lead and wait; print the result file if it stopped
  muse-task ls                        List tasks with lead and result statuses
  muse-task wait <name> [secs]        Wait until the lead stops working (default 600)
  muse-task result <name>             Print the result file, or the screen if none yet
  muse-task notify <name>             Tell the reviewer session the lead finished
  muse-task say <name> <text>         Send an answer or instruction to the lead
  muse-task trust <name>              Answer "Yes" to Claude's folder-trust dialog (after asonas approves)
  muse-task close <name>              End the lead and its coders; the result file stays

<repo> is a path, or a name or owner/name known to ghq.
Reviewer: run once in the reviewing session: hc label <terminal> muse-task.reviewer=1
Callers that open a new terminal per call (like Muse) should use run instead of separate start and wait.
USAGE
}

die() { echo "muse-task: $*" >&2; exit 1; }

resolve_repo() {
    local arg="$1" matches
    if [ -d "$arg" ]; then (cd "$arg" && pwd); return; fi
    matches="$(ghq list --full-path --exact "$arg" 2>/dev/null || true)"
    [ -n "$matches" ] || die "repository not found: $arg"
    [ "$(printf '%s\n' "$matches" | wc -l | tr -d ' ')" = 1 ] \
        || die "ambiguous repository $arg; use owner/name:
$matches"
    printf '%s\n' "$matches"
}

task_dir() {
    local d="$STATE_DIR/$1"
    [ -f "$d/meta" ] || die "unknown task: $1 (see muse-task ls)"
    printf '%s\n' "$d"
}

cmd_start() {
    [ $# -eq 2 ] || { usage >&2; exit 2; }
    local repo base name dir result prompt out stamp suffix attempt base_limit
    repo="$(resolve_repo "$1")"
    base="$(basename "$repo" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9-\n' '-' | cut -c1-13)"
    mkdir -p "$STATE_DIR"
    stamp="$(date +%m%d%H%M%S)"
    attempt=1
    suffix=""
    while :; do
        base_limit=$((13 - ${#suffix}))
        name="lead-${base:0:base_limit}-${stamp}${suffix}"
        dir="$STATE_DIR/$name"
        if mkdir "$dir" 2>/dev/null; then break; fi
        [ -d "$dir" ] || die "cannot create task folder: $dir"
        [ "$attempt" -lt 99 ] || die "too many task name collisions: $name"
        attempt=$((attempt + 1))
        suffix="-$attempt"
    done
    result="$dir/result.md"
    printf '%s\n' "$2" > "$dir/task.md"
    printf 'repo=%s\nstarted=%s\n' "$repo" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dir/meta"

    prompt="Read ${SKILL_DIR}/SKILL.md and act as the lead it describes.
Repository: ${repo}
Result file: ${result}
Coder model: ${CODER_MODEL}, effort ${CODER_EFFORT}
Task:
$2"

    out="$(hc run --bg --json --outlive-parent --name "$name" --cwd "$repo" \
        --label muse-task=1 --label "muse-task.result=$result" \
        -- /usr/bin/env "PATH=$PATH" claude --permission-mode auto -n "$name" "$prompt")" \
        || { rm -rf "$dir"; die "hc run failed: $out"; }
    printf '%s\n' "$out" > "$dir/launch.json"
    echo "name: $name"
    echo "terminal: $(printf '%s' "$out" | jq -r '.address // .terminal // "unknown"')"
    echo "repo: $repo"
    echo "result: $result"
}

status_of() {
    hc get "$1" --json 2>/dev/null \
        | jq -r 'if .state != "live" then "exited"
                 else (.status.state // "starting") end' 2>/dev/null \
        || echo "gone"
}

# Claude reports no status until its folder-trust dialog is answered, and
# hc wait would then wait for the program to exit.
asks_trust() {
    hc read --lines 0 "$1" 2>/dev/null | grep -q "trust this folder"
}

result_status() {
    local status
    status="$(awk '/^status:/ { sub(/^status:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit }' "$1" 2>/dev/null)" || status=unknown
    [[ "$status" =~ ^[a-z-]+$ ]] || status=unknown
    printf '%s\n' "$status"
}

cmd_ls() {
    local d name repo
    [ -d "$STATE_DIR" ] || { echo "no tasks"; return; }
    for d in "$STATE_DIR"/*/; do
        [ -f "$d/meta" ] || continue
        name="$(basename "$d")"
        repo="$(sed -n 's/^repo=//p' "$d/meta")"
        printf '%s\t%s\t%s\t%s\n' "$name" "$(status_of "$name")" \
            "$([ -f "$d/result.md" ] && result_status "$d/result.md" || echo no-result)" "$repo"
    done
}

cmd_wait() {
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    task_dir "$1" > /dev/null
    local out reason i
    for i in $(seq 30); do
        [ "$(status_of "$1")" = starting ] || break
        if asks_trust "$1"; then
            echo "blocked: Claude asks whether to trust the repository folder."
            echo "Ask asonas. If approved: muse-task trust $1"
            return
        fi
        sleep 2
    done
    [ "$(status_of "$1")" != starting ] || {
        echo "starting: no agent status after 60s; check with muse-task result $1"; return; }
    out="$(hc wait "$1" --json --timeout "${2:-600}" 2>&1 || true)"
    reason="$(printf '%s' "$out" | jq -r '.reason // empty' 2>/dev/null || true)"
    if [ "$reason" = timeout ]; then
        echo "still working (wait again, or read the result so far)"
    else
        echo "stopped: $(status_of "$1")"
    fi
}

cmd_run() {
    [ $# -eq 2 ] || [ $# -eq 3 ] || { usage >&2; exit 2; }
    local out name w
    out="$(cmd_start "$1" "$2")" || exit $?
    printf '%s\n' "$out"
    name="$(printf '%s\n' "$out" | sed -n 's/^name: //p')"
    w="$(cmd_wait "$name" ${3:+"$3"})"
    printf '%s\n' "$w"
    if [[ "$w" == stopped:* ]] && [ -f "$STATE_DIR/$name/result.md" ]; then
        cat "$STATE_DIR/$name/result.md"
    fi
}

cmd_result() {
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    local d; d="$(task_dir "$1")"
    if [ -f "$d/result.md" ]; then
        cat "$d/result.md"
    else
        echo "(no result file yet; status: $(status_of "$1"); last screen lines follow)"
        hc read --lines 40 "$1" 2>/dev/null || echo "(terminal is gone)"
    fi
}

cmd_notify() {
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    local name="$1" label="${MUSE_TASK_REVIEWER_LABEL:-muse-task.reviewer=1}"
    local dir result status targets count
    case "$name" in
        */*|*$'\n'*|*$'\r'*) echo "muse-task: warning: invalid task name; not notified" >&2; return 0 ;;
    esac
    dir="$STATE_DIR/$name"
    [ -f "$dir/meta" ] || {
        echo "muse-task: warning: unknown task: $name; not notified" >&2; return 0;
    }
    result="$dir/result.md"
    status="$(result_status "$result")"
    if ! targets="$(hc ls --json --label "$label" 2>/dev/null)"; then
        echo "muse-task: warning: hc ls failed for label $label; not notified" >&2
        return 0
    fi
    if ! targets="$(printf '%s' "$targets" | jq -r '.terminals[].address' 2>/dev/null)"; then
        echo "muse-task: warning: invalid hc ls response; not notified" >&2
        return 0
    fi
    if [ -z "$targets" ]; then
        echo "muse-task: warning: no reviewer terminal with label $label; not notified" >&2
        return 0
    fi
    count="$(printf '%s\n' "$targets" | wc -l | tr -d ' ')"
    if [ "$count" != 1 ]; then
        echo "muse-task: warning: multiple reviewer terminals with label $label; not notified" >&2
        return 0
    fi
    if hc send "$targets" "[muse-task] $name finished: status=$status result=$result" > /dev/null 2>&1; then
        echo "notified $targets"
    else
        echo "muse-task: warning: hc send failed for $targets; not notified" >&2
    fi
    return 0
}

cmd_say() {
    [ $# -eq 2 ] || { usage >&2; exit 2; }
    task_dir "$1" > /dev/null
    hc send "$1" "$2" > /dev/null
    echo "sent to $1"
}

# Answers Claude's folder-trust dialog with "Yes". Run only after asonas
# approves trusting that repository.
cmd_trust() {
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    task_dir "$1" > /dev/null
    asks_trust "$1" || die "$1 is not asking for folder trust"
    hc keys "$1" down enter > /dev/null
    echo "trusted; the lead continues. Use muse-task wait $1"
}

# Leads stay alive for follow-up answers, so they are ended explicitly.
# Coders are the lead's children and end with it. The result file stays.
cmd_close() {
    [ $# -eq 1 ] || { usage >&2; exit 2; }
    task_dir "$1" > /dev/null
    hc kill "$1" > /dev/null 2>&1 || true
    hc rm "$1" > /dev/null 2>&1 || true
    echo "closed $1"
}

case "${1:-}" in
    start) shift; cmd_start "$@" ;;
    run) shift; cmd_run "$@" ;;
    ls) shift; cmd_ls ;;
    wait) shift; cmd_wait "$@" ;;
    result) shift; cmd_result "$@" ;;
    notify) shift; cmd_notify "$@" ;;
    say) shift; cmd_say "$@" ;;
    trust) shift; cmd_trust "$@" ;;
    close) shift; cmd_close "$@" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
